# Per-account runtime state: checkpoints, session ids, logs, statusline captures.
# Machine-specific and regenerated by install.sh.
state/

# Which accounts this machine is configured with — personal, not shared.
accounts.json

# Published for other machines to read; regenerated on every ping.
schedule.json

# Entry point and wrappers generated by `claude-window wrappers`;
# they embed absolute paths.
bin/

# Generated by install.sh (contains machine-specific paths)
claude-early-window*.service
claude-early-window*.timer

# Python
__pycache__/
*.pyc
*.pyo
